# copy to .env and fill in; .env is gitignored
ODDS_API_KEY=your_key_here

# Kalshi: public market data needs no auth. These are only for the
# /historical tier and order placement.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_key.pem

# Verify this answers before deploying - Kalshi has moved hosts before
KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2

# Credit control for The Odds API (free tier = 500/month)
ODDS_MONTHLY_BUDGET=500
ODDS_RESERVE=40
ODDS_SNAPSHOTS_MIN=4320,1440,180,60,10
ODDS_PROP_MARKETS=player_receptions,player_rush_attempts,player_reception_yds
ODDS_SHARP_BOOK=pinnacle

# Poll cadence for the free exchanges
POLL_FUTURES=300
POLL_GAME=60
POLL_HOT=15

# --- Cloudflare R2: where raw shards go after RAW_ROTATE_DAYS ---------------
# Create an R2 bucket + an API token with Object Read & Write on it.
# Without these, rotation degrades (logged unhealthy in source_health) and the
# archive simply stays on local disk until the headroom floor stops it growing.
R2_ACCOUNT_ID=
R2_BUCKET=calibrated-sports-raw
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT defaults to https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PREFIX=raw

# --- Retention and headroom ------------------------------------------------
RAW_ROTATE_DAYS=7
QUOTES_RETENTION_DAYS=21
DISK_MIN_FREE_GB=5
DISK_WARN_FREE_GB=12
DEADMAN_MIN=20

# --- External dead-man (healthchecks.io) -----------------------------------
# New Check -> Period 20m, Grace 5m (matches DEADMAN_MIN). The logger pings
# this ONLY while data is arriving, so silence is the alert.
HEALTHCHECK_URL=
