+# ------------------------------- track F's rebuild and the staleness gate (f-25)
+
+def test_the_rebuild_runs_before_every_export_and_the_gate_runs_last(env):
+    tmp, _ = env
+    r = Runner()
+    assert W.run(runner=r, log=log_to(tmp), fetch=matching_fetch) == 0
+    names = r.names()
+    assert names.index("analytics-rebuild") < min(names.index(n) for n in ("export", "analytics"))
+    assert names[-1] == "staleness"
+    assert r.cmd_for("analytics-rebuild")[-4:] == ["--rebuild", "--season", str(W.season_now()),
+                                                   "--record-health"]
+    assert r.cmd_for("staleness")[-2:] == ["--gate", "--record-health"]
+
+
+def test_the_rebuild_runs_even_when_the_ingest_is_skipped(env):
+    tmp, _ = env
+    r = Runner()
+    assert W.run(skip_ingest=True, runner=r, log=log_to(tmp), fetch=matching_fetch) == 0
+    assert "analytics-rebuild" in r.names() and "ingest" not in r.names()
+
+
+def test_a_failing_rebuild_or_gate_never_fails_the_refresh(env):
+    tmp, _ = env
+    r = Runner(fail={"analytics-rebuild", "staleness"})
+    assert W.run(runner=r, log=log_to(tmp), fetch=matching_fetch) == 0
+    assert "upload" in r.names()
+    assert "track F's tables were not rebuilt" in read_log(tmp)
